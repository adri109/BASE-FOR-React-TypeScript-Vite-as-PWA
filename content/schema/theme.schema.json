{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "branch": {
      "type": "string",
      "enum": [
        "grammar",
        "vocabulary",
        "listening",
        "pronunciation"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "prerequisites": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "commonErrors": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wrong": {
            "type": "string",
            "minLength": 1
          },
          "right": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "wrong",
          "right"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "level",
    "branch",
    "title",
    "summary",
    "prerequisites",
    "explanation",
    "commonErrors"
  ],
  "additionalProperties": false
}
