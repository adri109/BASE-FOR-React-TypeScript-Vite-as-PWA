# Copia este fichero a .env.local para desarrollo local. No subas valores reales.
# Solo las variables con prefijo VITE_ se incluyen en el bundle del cliente,
# así que son visibles para cualquiera que abra la app: no pongas secretos aquí.

# Nombre que se muestra en la pantalla de ejemplo.
VITE_APP_NAME=PWA Template

# Subruta de despliegue (solo si no sirves desde la raíz del dominio).
# Ejemplo para GitHub Pages: /nombre-del-repo/
# Se lee en vite.config.ts, no en el código de la app.
VITE_BASE=/
