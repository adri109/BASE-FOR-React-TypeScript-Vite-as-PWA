# Copiar a .env.local (apps/web) o exportar en el entorno. Nunca commitear valores reales.
# Solo las variables con prefijo VITE_ llegan al bundle del cliente.

# Supabase (valores locales: salida de `pnpm db:status`)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Base URL pública de la app (OAuth / magic link redirect)
VITE_APP_URL=http://localhost:5173

# --- Solo servidor / CI (NO usar prefijo VITE_) ---
# Edge Functions locales: supabase/.env
SUPABASE_SERVICE_ROLE_KEY=

# Despliegue a Cloudflare Pages (secretos del repo en GitHub Actions)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=
